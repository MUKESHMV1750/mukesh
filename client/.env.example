# Full-stack Vercel Deployment (Default & Recommended):
# Do NOT set VITE_API_URL in Vercel, or set it to:
VITE_API_URL=/api/v1
# (Never set VITE_API_URL to a Vercel preview URL ending in .vercel.app, as preview URLs require SSO authentication)

# Separate External Backend (Only if hosting Node backend separately on Render):
# VITE_API_URL=https://your-backend.onrender.com
