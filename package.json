{
  "name": "drivex",
  "version": "1.0.0",
  "description": "DriveX – Cloud File Manager and Sharing System",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client install && npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "db:setup": "node server/src/scripts/setupDatabase.js",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install"
  },
  "keywords": [
    "cloud",
    "file-manager",
    "google-drive",
    "google-sheets"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "googleapis": "^140.0.1",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
