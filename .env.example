# ==============================================================
# DriveX — Vercel Environment Variables Configuration
# ==============================================================
# When deploying to Vercel (Project Settings -> Environment Variables),
# add the following environment variables:

# Server Environment
NODE_ENV=production
PORT=5000

# Security (Change to your own strong random string)
SESSION_SECRET=drivex-production-secret-change-to-a-secure-random-key

# Admin Password Hash (Default hash is for password: mukesh188)
# Generated using bcrypt (cost 10)
ADMIN_PASSWORD_HASH=$2a$10$qS0INoAz8ocSRYAdL1Gbuuf19WcNjgx4o/MybmSroScwFNmmwlSKu

# Google Cloud Platform Integration
# 1. Google Sheets Spreadsheet ID (found in your Google Sheet URL /d/<SPREADSHEET_ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id

# 2. Service Account Email (from GCP service account credentials)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 3. Service Account Private Key (include -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY-----)
# In Vercel dashboard, paste the private key directly (newlines \n are handled automatically)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 4. Google Drive Folder ID (found in your Drive folder URL /folders/<FOLDER_ID>)
# Ensure this folder is shared with your Service Account Email with "Editor" permission
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id

# Optional: Custom Client URL (if not using the default unified Vercel deployment domain)
# CLIENT_URL=https://your-custom-domain.vercel.app
